+        source=data.source,
+    )
+    db.add(ticket)
+    await db.commit()
+    await db.refresh(ticket)
+    # 创建 SLA 记录（ticket 已有 id）
+    await create_sla_record(db, ticket)
+    await db.commit()
+    await db.refresh(ticket)
+    return ticket
