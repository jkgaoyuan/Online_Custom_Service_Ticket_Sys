+    ticket3 = await _create_ticket(db, "Normal 3", "Desc", category.id, customer.id)
+
+    # Manually mark SLAs as breached
+    result = await db.execute(select(SLARecord).where(SLARecord.ticket_id == ticket1.id))
+    sla1 = result.scalar_one()
