+    assert "first_resp_breached" in data["sla"]
+    assert "resolution_breached" in data["sla"]
+    # SLASummary should NOT include ticket_id or hours
+    assert "ticket_id" not in data["sla"]
+    assert "first_resp_hours" not in data["sla"]
